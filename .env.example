# ==============================================================================
# XSS-Lab Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set environment variables in your local shell / container.
# All settings default to safe, local-only defaults if omitted.
# ==============================================================================

# Server Network Binding
PORT=3000
HOST=127.0.0.1

# Optional Advanced Browser Framework Integration (BeEF)
# Note: BeEF is entirely optional. Standard XSS testing does not require BeEF.
BROWSER_EXPLOITATION_LAB_ENABLED=false
LOCAL_LAB_HOST=127.0.0.1

# BeEF REST API Settings (Used during Full Lab Restore cleanup)
BEEF_API_URL=http://127.0.0.1:3001
BEEF_USER=beef
BEEF_PASSWORD=beef
# BEEF_TOKEN=
